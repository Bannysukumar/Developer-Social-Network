# Copy to .env and replace every placeholder before production use.
# Never commit a real .env file.

SPRING_PROFILES_ACTIVE=dev

# Local docker-compose publishes MongoDB on 127.0.0.1 only.
MONGODB_URI=mongodb://social:social_dev_password@localhost:27017/socialnetwork?authSource=admin
MONGO_INITDB_ROOT_USERNAME=social
MONGO_INITDB_ROOT_PASSWORD=social_dev_password

# At least 32 bytes. Production must not use this example value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Comma-separated browser origins. Never use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# memory (default) or redis. Redis is optional and used only when store=redis.
RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379

# Leave MAIL_HOST empty to skip real delivery. Tokens are never logged.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
APP_PUBLIC_URL=http://localhost:3000

APP_SWAGGER_ENABLED=true
TRUST_PROXY=false
REQUIRE_EMAIL_VERIFIED=false
