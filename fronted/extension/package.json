{
  "name": "devconnect-vscode-extension",
  "displayName": "DevConnect",
  "description": "Discover developers, manage friendships, and exchange private messages inside Visual Studio Code.",
  "keywords": [
    "developer networking",
    "developer community",
    "friends",
    "messaging",
    "chat",
    "notifications"
  ],
  "publisher": "Bannysukumar2255",
  "version": "0.4.48",
  "icon": "assets/devconnect.png",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:devconnect.home",
    "onCommand:devconnect.open",
    "onCommand:devconnect.openMessages",
    "onCommand:devconnect.openNotifications",
    "onCommand:devconnect.openFriends",
    "onCommand:devconnect.openProfile",
    "onCommand:devconnect.openSettings",
    "onCommand:devconnect.markNotificationsRead"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devconnect",
          "title": "DevConnect",
          "icon": "assets/devconnect.svg"
        }
      ]
    },
    "views": {
      "devconnect": [
        {
          "type": "webview",
          "id": "devconnect.home",
          "name": "Home"
        }
      ]
    },
    "commands": [
      {
        "command": "devconnect.open",
        "title": "DevConnect: Open"
      },
      {
        "command": "devconnect.openMessages",
        "title": "DevConnect: Open Messages"
      },
      {
        "command": "devconnect.openNotifications",
        "title": "DevConnect: Open Notifications"
      },
      {
        "command": "devconnect.openFriends",
        "title": "DevConnect: Open Friends"
      },
      {
        "command": "devconnect.openProfile",
        "title": "DevConnect: Open Profile"
      },
      {
        "command": "devconnect.openSettings",
        "title": "DevConnect: Open Settings"
      },
      {
        "command": "devconnect.markNotificationsRead",
        "title": "DevConnect: Mark Notifications as Read"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "bun test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
